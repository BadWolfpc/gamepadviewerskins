/* =========================================================
   GAMEPAD VIEWER — PS4 WOODLAND CAMO SKIN
   ========================================================= */

/* Controller body */
.controller.ps4 {
    background: transparent !important;
}

/* Main controller shell */
.controller.ps4 .face {
    background-color: #39452b !important;

    /* Woodland camouflage */
    background-image:
        radial-gradient(
            ellipse at 20% 25%,
            #1d2919 0%,
            #1d2919 8%,
            transparent 9%
        ),
        radial-gradient(
            ellipse at 75% 20%,
            #4b3824 0%,
            #4b3824 10%,
            transparent 11%
        ),
        radial-gradient(
            ellipse at 55% 70%,
            #202b1a 0%,
            #202b1a 13%,
            transparent 14%
        ),
        radial-gradient(
            ellipse at 15% 75%,
            #57432a 0%,
            #57432a 9%,
            transparent 10%
        ),
        radial-gradient(
            ellipse at 85% 65%,
            #26351e 0%,
            #26351e 12%,
            transparent 13%
        ),
        linear-gradient(
            135deg,
            #465635 0%,
            #465635 35%,
            #303c25 35%,
            #303c25 65%,
            #4a3823 65%,
            #4a3823 100%
        ) !important;

    box-shadow:
        inset 0 0 0 2px rgba(0,0,0,.45),
        inset 0 8px 15px rgba(255,255,255,.06),
        0 6px 15px rgba(0,0,0,.55) !important;

    filter: saturate(.9);
}

/* Controller edge / outline */
.controller.ps4 .face::after {
    background: transparent !important;
}

/* =========================================================
   D-PAD
   ========================================================= */

.controller.ps4 .dpad {
    filter: brightness(.65) contrast(1.15);
}

.controller.ps4 .dpad .face {
    background: #20261b !important;
}

/* =========================================================
   ANALOG STICKS
   ========================================================= */

.controller.ps4 .sticks {
    filter: brightness(.55) contrast(1.2);
}

.controller.ps4 .stick {
    background: #1b2118 !important;

    box-shadow:
        inset 0 2px 3px rgba(255,255,255,.08),
        inset 0 -3px 5px rgba(0,0,0,.65),
        0 2px 4px rgba(0,0,0,.5) !important;
}

/* =========================================================
   PS4 FACE BUTTONS
   ========================================================= */

.controller.ps4 .button {
    background: #20251b !important;

    box-shadow:
        inset 0 2px 2px rgba(255,255,255,.08),
        inset 0 -3px 4px rgba(0,0,0,.7),
        0 2px 4px rgba(0,0,0,.45) !important;

    color: #b8c0a5 !important;
}

/* Triangle */
.controller.ps4 .button.triangle {
    color: #75885a !important;
}

/* Circle */
.controller.ps4 .button.circle {
    color: #7e8065 !important;
}

/* Cross */
.controller.ps4 .button.cross {
    color: #a0a58d !important;
}

/* Square */
.controller.ps4 .button.square {
    color: #687b63 !important;
}

/* =========================================================
   OPTIONS / SHARE
   ========================================================= */

.controller.ps4 .start,
.controller.ps4 .select {
    background: #20261b !important;
    color: #879076 !important;

    box-shadow:
        inset 0 1px 2px rgba(255,255,255,.05),
        inset 0 -2px 3px rgba(0,0,0,.6) !important;
}

/* =========================================================
   PS BUTTON
   ========================================================= */

.controller.ps4 .ps {
    background: #151a13 !important;

    box-shadow:
        inset 0 2px 3px rgba(255,255,255,.05),
        inset 0 -3px 5px rgba(0,0,0,.8),
        0 2px 5px rgba(0,0,0,.6) !important;
}

/* =========================================================
   TRIGGERS
   ========================================================= */

.controller.ps4 .trigger {
    background: #252c1d !important;

    box-shadow:
        inset 0 2px 3px rgba(255,255,255,.06),
        inset 0 -4px 6px rgba(0,0,0,.7) !important;
}

/* =========================================================
   BUMPERS
   ========================================================= */

.controller.ps4 .bumper {
    background: #252c1d !important;

    box-shadow:
        inset 0 2px 2px rgba(255,255,255,.06),
        inset 0 -3px 4px rgba(0,0,0,.65) !important;
}

/* =========================================================
   TOUCHPAD
   ========================================================= */

.controller.ps4 .touchpad {
    background:
        radial-gradient(
            ellipse at 30% 35%,
            #536040 0%,
            #536040 12%,
            transparent 13%
        ),
        radial-gradient(
            ellipse at 75% 65%,
            #292f20 0%,
            #292f20 15%,
            transparent 16%
        ),
        #3d482f !important;

    box-shadow:
        inset 0 2px 5px rgba(255,255,255,.06),
        inset 0 -4px 7px rgba(0,0,0,.6),
        0 2px 4px rgba(0,0,0,.4) !important;
}

/* =========================================================
   LIGHT BAR
   ========================================================= */

.controller.ps4 .lightbar {
    background: #66784b !important;
    box-shadow:
        0 0 8px rgba(102,120,75,.45) !important;
}
